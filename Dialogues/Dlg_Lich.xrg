		*SOUND ge_lich121
	}
	*118 
	{
		*TEXT "让我们结束这一切吧，"
		*SUBTITLEDURATION 3
		*SOUND ge_lich122
	}
	*119 
	{
		*TEXT "我的灵魂正变得焦躁不安。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*120 
	{
		*TEXT "我的骨头终将"
		*SUBTITLEDURATION 3
		*SOUND ge_lich123
	}
	*121 
	{
		*TEXT "化为尘土，我的灵魂将"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*122 
	{
		*TEXT "回归它所属的地方。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*123 
	{
		*TEXT "祈求这一天早日到来。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*124 
	{
		*TEXT "冥界指引着我。"
		*SUBTITLEDURATION 3
		*SOUND ge_lich124
	}
	*125 
	{
		*TEXT "是的。"
		*SUBTITLEDURATION 3
