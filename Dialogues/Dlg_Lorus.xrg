*dialogue default
{
	*25 ma_painsml
	*26 ma_painsml
	*27 ma_death
	*28 ma_death
	*29 ma_death
	*30 ma_death
	*40 ma_atksml01
	*41 ma_atksml01
	*100 
	{
		*TEXT "是的。"
		*SUBTITLEDURATION 3
		*SOUND gen_lorus001
		*COLOR 0xfefefe
	}
	*101 
	{
		*TEXT "不。"
		*SUBTITLEDURATION 3
		*SOUND gen_lorus002
		*COLOR 0xfefefe
	}
	*102 
	{
		*TEXT "嗯……"
		*SUBTITLEDURATION 3
		*SOUND gen_lorus003
		*COLOR 0xfefefe
	}
	*103 
	{
		*TEXT "我的荣幸。"
		*SUBTITLEDURATION 3
		*SOUND gen_lorus004
		*COLOR 0xfefefe
	}
	*104 
	{
		*TEXT "很好。"
		*SUBTITLEDURATION 3
		*SOUND gen_lorus005
		*COLOR 0xfefefe
	}
	*105 
	{
		*TEXT "对。"
		*SUBTITLEDURATION 3
		*SOUND gen_lorus006
		*COLOR 0xfefefe
	}
	*106 
	{
		*TEXT "嘿，别闹了！"
		*SUBTITLEDURATION 3
		*SOUND gen_lorus007
		*COLOR 0xfefefe
	}
	*107 
	{
		*TEXT "马库斯派你来的？那个卑劣的小人！"
		*SUBTITLEDURATION 3
		*SOUND ls07_01
		*COLOR 0xfefefe
	}
	*109 
	{
		*TEXT "我是唯一一个去过那边又回来的人。"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*111 
	{
		*TEXT "但如果你想要我的帮助，"
		*COLOR 0xfefefe
	}
	*112 
	{
		*TEXT "你得先为我做件事。"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*114 
	{
		*TEXT "马库斯拿走了我的航海日志和其他的"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*116 
	{
		*TEXT "他本该为我出售的货物。"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*117 
	{
		*TEXT "这白痴把它卖给了一些这里的当地人，"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*119 
	{
		*TEXT "而他们拒绝归还！"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*120 
	{
		*TEXT "把我的书拿回来！"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*121 
	{
		*TEXT "然后我们再谈谈把你送到另一边去的事。"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*123 
	{
		*TEXT "不过仍然不会便宜。还要当心那些水域！"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*124 
	{
		*TEXT "它比看起来冷得多。"
		*SUBTITLEDURATION 3
		*COLOR 0xfefefe
	}
	*126 
	{
		*TEXT "我还是想不通为什么有人"
		*SOUND ls07_02
	}
	*127 
	{
		*TEXT "会想去那个"
		*SOUND 
	}
	*128 
	{
		*TEXT "被神遗弃的梅克伦那个鬼地方。"
		*SOUND 
	}
	*129 
	{
		*TEXT "我听说外域者正在"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*130 
	{
		*TEXT "那里发动战争，甚至现在就在打。"
		*SOUND 
	}
	*131 
	{
		*TEXT "但那是你的问题，不是我的！"
		*SOUND 
	}
	*132 
	{
		*TEXT "我们依然在黎明时分开船。"
		*SOUND 
	}
}
