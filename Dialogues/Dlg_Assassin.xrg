	}
	*102 
	{
		*TEXT "你听到的声音，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*104 
	{
		*TEXT "是你死亡的声音。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*106 
	{
		*TEXT "是我外域者同胞们雷鸣般的滚滚动地声。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*108 
	{
		*TEXT "是德雷格'阿塔尔"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*109 
	{
		*TEXT "屠杀你们同类的声音，"
