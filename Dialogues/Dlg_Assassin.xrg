	}
	*126 
	{
		*TEXT "跟我来！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin016
	}
	*127 
	{
		*TEXT "救命！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin021
	}
	*128 
	{
		*TEXT "救救我！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin022
	}
	*129 
	{
		*TEXT "我想我能帮到你。"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin026
	}
	*130 
	{
		*TEXT "嘿，你，这边！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin044
	}
	*131 
	{
		*TEXT "我在这儿！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin046
	}
	*132 
	{
		*TEXT "我们遭到攻击了！"
		*SUBTITLEDURATION 3
