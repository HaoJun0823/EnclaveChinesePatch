	}
	*148 
	{
		*TEXT "我是一名刺客，最好的那种。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*150 
	{
		*TEXT "我为这件武器准备了多日。"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin121
	}
	*152 
	{
		*TEXT "我正变得焦躁不安，我想使用它。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*154 
	{
		*TEXT "这里面有什么好处吗？"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin122
	}
	*156 
	{
		*TEXT "我既能快速，也能痛苦地送达死亡。"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin123
	}
	*159 
	{
		*TEXT "尝尝这个！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin124
	}
	*160 
	{
		*TEXT "感受这个吧，你这混蛋！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin125
	}
	*161 
	{
		*TEXT "这会给你个教训！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin126
	}
	*162 
	{
		*TEXT "你找不到更好的人了！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin127
	}
	*164 
	{
		*TEXT "我是最强的！"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin128
	}
	*165 
	{
		*TEXT "是的。"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin301
	}
	*166 
	{
		*TEXT "不。"
		*SUBTITLEDURATION 3
