	}
	*167 
	{
		*TEXT "嗯……"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin303
	}
	*168 
	{
		*TEXT "不客气。"
		*SUBTITLEDURATION 3
		*SOUND ge_assassin304
	}
	*169 
	{
		*TEXT "我的荣幸。"
