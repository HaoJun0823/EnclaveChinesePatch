		*SOUND ls01_03
	}
	*115 
	{
		*TEXT "如果他们没能先抓住你，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*117 
	{
		*TEXT "我会亲手把你撕碎，用我的——"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*119 
	{
		*TEXT "我会回来的，在这里等我。"
