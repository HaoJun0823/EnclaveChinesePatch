*dialogue default
{
	*25 f4_painsml
	*26 f4_painmed
	*27 f4_death
	*28 f4_death
	*29 f4_death
	*30 f4_death
	*40 f4_atksml01
	*41 f4_atkmed01
	*100 
	{
		*TEXT "你为我们提供了巨大的帮助"
		*SUBTITLEDURATION 3
		*SOUND csl01_01
	}
	*101 
	{
		*TEXT "协助击退这些卑劣的入侵者"
		*SOUND 
	}
	*103 
	{
		*TEXT "尽管你曾被囚禁，这至少可以说是大胆之举。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*105 
	{
		*TEXT "你确实曾对我们犯下罪行。"
		*SUBTITLEDURATION 3
		*SOUND csl01_05
	}
	*107 
	{
		*TEXT "然而你似乎愿意证明你对塞勒海姆的忠诚。"
		*SUBTITLEDURATION 5
		*SOUND 
	}
	*108 
	{
		*TEXT ""
		*SOUND 
	}
	*109 
	{
		*TEXT "因此，我将向你提出一个提议。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*111 
	{
		*TEXT "如果你继续为我们的事业服务，并协助我们这次行动，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*112 
	{
		*TEXT "你将获得完全赦免，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*114 
	{
		*TEXT "并且从此将被接纳为光荣的战士。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*116 
	{
		*TEXT "在"
		*SUBTITLEDURATION 3
		*SOUND csl01_06
	}
	*117 
	{
		*TEXT "塞拉迪亚村，有一个名叫马库斯的商人。他对飞地来说非常重要——"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*119 
	{
		*TEXT "因为他是最后一个愿意穿越"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*120 
	{
		*TEXT "裂隙，为我们带来急需补给品的商人，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*122 
	{
		*TEXT "如果我们还希望能抵挡住"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*123 
	{
		*TEXT "德雷格'阿塔尔日益频繁的袭击的话。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*125 
	{
		*TEXT "我收到消息说，德雷格'阿塔尔已经——"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*127 
	{
		*TEXT "袭击了他的车队，并企图"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*128 
	{
		*TEXT "刺杀他。他必须受到保护。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*130 
	{
		*TEXT "没有他我们撑不了多久。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*132 
	{
		*TEXT "所以你就是扎尔……"
		*SUBTITLEDURATION 3
		*SOUND csl02_01
	}
	*133 
	{
		*TEXT "我以为你早就死了。"
		*SUBTITLEDURATION 2
		*SOUND 
	}
	*135 
	{
		*TEXT "什么援助？我没有请求先祖的援助！"
		*SUBTITLEDURATION 3.5
		*SOUND csl02_03
	}
	*138 
	{
		*TEXT "他们鄙视我们！"
		*SUBTITLEDURATION 3.8
		*SOUND 
	}
	*139 
	{
		*TEXT "所以，这就是最终的结果。"
		*SUBTITLEDURATION 3
		*SOUND ds13_04
	}
	*141 
	{
		*TEXT "看来你的主人缺乏"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*143 
	{
		*TEXT "亲自面对我的勇气或荣誉！"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*144 
	{
		*TEXT "德雷格'阿塔尔，你指望能达成什么目的？"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*146 
	{
		*TEXT "没有我们，大地将失去魔法！"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*148 
	{
		*TEXT "我们……就是魔法！"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*149 
	{
		*TEXT "了结你此行的目的吧。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*150 
	{
		*TEXT "但别指望这会很容易！"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*151 
	{
		*TEXT "怎么样？"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel001
	}
	*152 
	{
		*TEXT "别让他们跑了！"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel002
	}
	*153 
	{
		*TEXT "你永远无法打败我们！"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel003
	}
	*154 
	{
		*TEXT "受死吧！"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel004
	}
	*155 
	{
		*TEXT "杀了他们！"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel005
	}
	*156 
	{
		*TEXT "怎么样？"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel007
	}
	*157 
	{
		*TEXT "是的。"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel008
	}
	*158 
	{
		*TEXT "不。"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel009
	}
	*159 
	{
		*TEXT "嗯……"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel010
	}
	*160 
	{
		*TEXT "我的荣幸。"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel011
	}
	*161 
	{
		*TEXT "很好。"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel012
	}
	*162 
	{
		*TEXT "对。"
		*SUBTITLEDURATION 3
		*SOUND gen_aylindel013
	}
	*163 
	{
		*TEXT "除非被问话，否则请不要发言。"
		*SUBTITLEDURATION 3
		*SOUND ge_aylindel119
	}
	*165 
	{
		*TEXT "我不喜欢你说话的语调。"
		*SUBTITLEDURATION 3
		*SOUND ge_aylindel120
	}
	*167 
	{
		*TEXT "塞勒海姆的命运掌握在你手中"
		*SUBTITLEDURATION 3
		*SOUND ge_aylindel123
	}
	*169 
	{
		*TEXT "不要让我们失望。"
		*SUBTITLEDURATION 3
		*SOUND ge_aylindel124
	}
	*170 
	{
		*TEXT "你是我们唯一的希望！"
		*SUBTITLEDURATION 3
		*SOUND ge_aylindel125
	}
}
