{
	*20 			// Sats_ground
	*22 land_grounde		// land 1
	*23 land_grounde		// land 2
	*24 land_grounde		// land 3
	*25 vat_painsml			// Pain 0
	*26 vat_painsml			// Pain 1
	*27 vat_death			// Death standard
	*28 vat_death			// Death fall
	*29 vat_death			// Death gib
	*30 vat_death			// Death fire
	*31 ft_grounde			// Footstep medium
	*32 ft_grounde			// Footstep hard
	*33 ft_grounde			// Footstep drag
	*40 vat_atksml01		// Melee charge 1
	*41 vat_atksml01		// Melee charge 2
	*42 mel_magic02			// Sword swish
	*43 mel_magic02			// Axe swish
	*44 mel_magic02			// Hammer swish
	*45 mel_magic02			// Dagger swish
	*60 vat_roar01
	*61 vat_roar02
	
	*70 vat_roar05
	*71 vat_roar06
	
	*80 dem_expl19c	// Bodyfall
	*81 du_special02	// Super attack 1
	*100 
	{
		*TEXT "挣扎是徒劳的，凡人！"
		*SUBTITLEDURATION 3
		*SOUND vat_speech01
		*FLAGS 2
	}
	*101 
	{
		*TEXT "很快，我的大军将再次崛起，"
		*SUBTITLEDURATION 3
		*SOUND vat_speech02
		*FLAGS 2
	}
	*102 
	{
		*TEXT "我将吸干你们那片珍贵小土地上的魔法！"
		*SUBTITLEDURATION 3
		*SOUND vat_speech05
		*FLAGS 2
	}
	*103 
	{
		*TEXT "很好！你的折磨将带给我巨大的愉悦。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech06
		*FLAGS 2
	}
	*105 
	{
		*TEXT "时间不多了……"
		*SUBTITLEDURATION 3
		*SOUND vat_speech07
		*FLAGS 2
	}
	*106 
	{
		*TEXT "我将赐予你超乎想象的强大力量。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech05
		*FLAGS 2
	}
	*107 
	{
		*TEXT "去乌尔-安农岛找到莫德萨……"
		*SUBTITLEDURATION 3
		*SOUND vat_speech01
		*FLAGS 2
	}
	*108 
	{
		*TEXT "不要……失败……于我。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech06
		*FLAGS 2
	}
	*109 
	{
		*TEXT "我需要……自由……"
		*SUBTITLEDURATION 3
		*SOUND vat_speech08
		*FLAGS 2
	}
	*110 
	{
		*TEXT "让我从莫德萨的束缚中解脱出来，凡人！"
		*SUBTITLEDURATION 3
		*SOUND vat_speech02
		*FLAGS 2
	}
	*112 
	{
		*TEXT "终于……我自由了！"
		*SUBTITLEDURATION 3
		*SOUND vat_speech06
		*FLAGS 2
	}
	*113 
	{
		*TEXT "就在我们说话的时候，我的大军正在穿越裂隙。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech05
		*FLAGS 2
	}
	*114 
	{
		*TEXT "这场战斗将是决定性的，而且不会有任何怜悯。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech02
		*FLAGS 2
	}
	*115 
	{
		*TEXT "他们土地上的魔法将属于我，"
		*SUBTITLEDURATION 3
		*SOUND vat_speech08
		*FLAGS 2
	}
	*116 
	{
		*TEXT "他们每一个人都将成为我的奴隶。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech01
		*FLAGS 2
	}
	*118 
	{
		*TEXT "现在，找到进入塞勒海姆城堡的方法。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech03
		*FLAGS 2
	}
	*119 
	{
		*TEXT "干掉精灵女王。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech06
		*FLAGS 2
	}
	*120 
	{
		*TEXT "没有了领袖，飞地将失去战斗的意志。"
		*SUBTITLEDURATION 3
		*SOUND vat_speech02
		*FLAGS 2
	}
}
