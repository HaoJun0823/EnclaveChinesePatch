*dialogue default
{
	*25 zal_painsml
	*26 zal_painmed
	*27 zal_death
	*28 zal_death
	*29 zal_death
	*30 zal_death
	*40 zal_atksml01
	*41 zal_atkmed01
	*100 
	{
		*TEXT "以和平的名义！"
		*SUBTITLEDURATION 3
		*SOUND ls12_01
	}
	*101 
	{
		*TEXT "以和平的名义，"
		*SUBTITLEDURATION 3
		*SOUND ls12_02
	}
	*102 
	{
		*TEXT "那个被双方撕毁的盟约。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*103 
	{
		*TEXT "让它成为纽带，愈合"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*104 
	{
		*TEXT "他们之间的裂隙。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*105 
	{
		*TEXT "如果和平有任何机会"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*106 
	{
		*TEXT "在那些下令摧毁"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*107 
	{
		*TEXT "美好事物，只为战争的人心中"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*108 
	{
		*TEXT "生长的话。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*109 
	{
		*TEXT "让它在此时实现吧。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*110 
	{
		*TEXT "要塞被一道魔法屏障锁住了。"
		*SUBTITLEDURATION 3.5
		*SOUND ls12_03
	}
	*111 
	{
		*TEXT ""
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*112 
	{
		*TEXT "你需要找到三把钥匙。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*113 
	{
		*TEXT "我需要所有的钥匙。快去！"
		*SUBTITLEDURATION 3
		*SOUND ls12_04
	}
	*114 
	{
		*TEXT "你还等什么？"
		*SUBTITLEDURATION 3.5
		*SOUND ls12_05
	}
	*115 
	{
		*TEXT "它不会自己打开的！"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*116 
	{
		*TEXT "怎么样？"
		*SUBTITLEDURATION 3.5
		*SOUND ls12_06
	}
	*117 
	{
		*TEXT "快，跟我来！"
		*SUBTITLEDURATION 3.5
		*SOUND ls12_07
	}
	*118 
	{
		*TEXT "正是时候！"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_01
	}
	*119 
	{
		*TEXT "别以为我不知道"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*120 
	{
		*TEXT "你一直在做什么。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*121 
	{
		*TEXT "我可能一直被囚禁着，但"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*122 
	{
		*TEXT "对外面的世界并非一无所知。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*123 
	{
		*TEXT "你想要我摧毁"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_02
	}
	*124 
	{
		*TEXT "卡姆-扎拉的高地通道。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*125 
	{
		*TEXT "为什么你们这些人总是"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*126 
	{
		*TEXT "跑来要我摧毁东西？"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*127 
	{
		*TEXT "我需要先拿到"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*128 
	{
		*TEXT "大地之灵法杖。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*129 
	{
		*TEXT "它在我击败瓦塔尔时遗失了，"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*130 
	{
		*TEXT "我相信它"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*131 
	{
		*TEXT "仍然在下方的"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*132 
	{
		*TEXT "冥界某处。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*133 
	{
		*TEXT "因为我仍然能感觉到它的存在。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*134 
	{
		*TEXT "找到法杖，然后到"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*135 
	{
		*TEXT "卡姆-扎拉与我汇合"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*136 
	{
		*TEXT "怎么样？快去！"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_03
	}
	*137 
	{
		*TEXT "嘿！"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_04
	}
	*138 
	{
		*TEXT "这次试着做对好吗？"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_05
	}
	*139 
	{
		*TEXT "太棒了……"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_06
	}
	*140 
	{
		*TEXT "那个不对……"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_07
	}
	*141 
	{
		*TEXT "我不喜欢那声音……"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_08
	}
	*142 
	{
		*TEXT "如果你要请我"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_09
	}
	*143 
	{
		*TEXT "帮忙，就给我做好！"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*144 
	{
		*TEXT "呃……不对？"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_10
	}
	*145 
	{
		*TEXT "再试一次……"
		*SUBTITLEDURATION 3.5
		*SOUND ls09_11
	}
	*146 
	{
		*TEXT "你们这些人上当了，我真高兴！"
		*SUBTITLEDURATION 3.5
		*SOUND csl02_02
	}
	*147 
	{
		*TEXT "也不是我有什么选择，"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*148 
	{
		*TEXT "我被困住了。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*149 
	{
		*TEXT "陛下，您所请求的"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*150 
	{
		*TEXT "先祖援助已在路上。"
		*SUBTITLEDURATION 2
		*SOUND 
	}
	*151 
	{
		*TEXT "他们已命令您的战士们"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*152 
	{
		*TEXT "摧毁卡姆-扎拉的通道，"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*153 
	{
		*TEXT "以便他们能派遣军队通过。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*155 
	{
		*TEXT "也许他们现在恢复理智，"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*156 
	{
		*TEXT "寻求与您和平相处。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*158 
	{
		*TEXT "我担心最坏的情况。"
		*SUBTITLEDURATION 3.5
		*SOUND csl02_06
	}
	*159 
	{
		*TEXT "莫德萨一定把她"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*160 
	{
		*TEXT "带去了阿克穆尔的要塞"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*161 
	{
		*TEXT "你必须立刻赶往那里，"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*162 
	{
		*TEXT "阻止召唤仪式"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*163 
	{
		*TEXT "的发生。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*164 
	{
		*TEXT "没时间浪费了。快去！"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*165 
	{
		*TEXT "我担心最终会"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*166 
	{
		*TEXT "变成这样。把书给我！"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*167 
	{
		*TEXT "我在你眼里像什么？"
		*SUBTITLEDURATION 3.5
		*SOUND ge_zale119
	}
	*168 
	{
		*TEXT "抄写员？锁匠？"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*169 
	{
		*TEXT "给我走开！"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*170 
	{
		*TEXT "你现在又想怎样。"
		*SUBTITLEDURATION 3.5
		*SOUND ge_zale120
	}
	*171 
	{
		*TEXT "没看见我正忙着吗？"
		*SUBTITLEDURATION 3.5
		*SOUND ge_zale121
	}
	*172 
	{
		*TEXT "是的，我是扎尔。是的，是我放逐了"
		*SUBTITLEDURATION 3.5
		*SOUND ge_zale122
	}
	*173 
	{
		*TEXT "瓦塔尔，也是我分隔了世界。"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*174 
	{
		*TEXT "我能走了吗？"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*175 
	{
		*TEXT "我能走了吗？"
		*SUBTITLEDURATION 3.5
		*SOUND ge_zale123
	}
	*176 
	{
		*TEXT "是的，我早就全知道了。"
		*SUBTITLEDURATION 3.5
		*SOUND ge_zale124
	}
	*177 
	{
		*TEXT "所以别用"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*178 
	{
		*TEXT "闲聊浪费我的时间！"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*179 
	{
		*TEXT "我也不喜欢你！"
		*SUBTITLEDURATION 3.5
		*SOUND ge_zale125
	}
	*180 
	{
		*TEXT "那么，我们又见面了……"
		*SUBTITLEDURATION 3.5
		*SOUND ge_zale126
	}
	*181 
	{
		*TEXT "陛下，但他们同意来了！"
		*SUBTITLEDURATION 3.5
		*SOUND csl02_04
	}
	*183 
	{
		*TEXT "所以他们也违反了吉'富罗的盟约"
		*SUBTITLEDURATION 3.5
		*SOUND 
	}
	*185 
	{
		*TEXT "我担心会变成这样。把书给我！"
		*SOUND ds06_01
		*SUBTITLEDURATION 3.5
	}
}
