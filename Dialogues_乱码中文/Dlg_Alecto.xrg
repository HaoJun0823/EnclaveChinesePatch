*dialogue default
{
	*25 m1_painsml
	*26 m1_painmed
	*27 m1_death
	*28 m1_death
	*29 m1_death
	*30 m1_death
	*40 m1_atksml01
	*41 m1_atkmed01
	*61 ale_aidete
	*62 ale_aispot
	*63 ale_aichar
	*66 ale_aisurp
	*100 
	{
		*TEXT "啊，令人印象深刻！我一直注视着你的一举一动"
		*SUBTITLEDURATION 3
		*SOUND ls08_01
	}
	*101 
	{
		*TEXT "在这场小小的旅程中。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*104 
	{
		*TEXT "塞勒海姆是一段相当遥远的旅途，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*105 
	{
		*TEXT "并且我相信我们可能面临一个共同的问题。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*107 
	{
		*TEXT "你正在寻求我们对抗外域者的援助，是吗？"
		*SUBTITLEDURATION 3
		*SOUND ls08_02
	}
	*109 
	{
		*TEXT "塞勒海姆的魔法同样存在于我们的土地中，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*111 
	{
		*TEXT "毫无疑问他们很快就要入侵我们了！"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*113 
	{
		*TEXT "然而，有一个问题必须首先"
		*SUBTITLEDURATION 3
		*SOUND ls08_03
	}
	*114 
	{
		*TEXT "得到解决。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*116 
	{
		*TEXT "如你所知，卡姆-扎拉的通道非常狭窄，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*118 
	{
		*TEXT "一整支军队都有可能被"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*120 
	{
		*TEXT "区区几个人击败，如果他们守住那里的话。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*122 
	{
		*TEXT "它曾处于我们的控制之下，但德雷格'阿塔尔"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*124 
	{
		*TEXT "从内部渗透并自己夺取了它！"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*126 
	{
		*TEXT "为了帮助我们，你必须确保这条通道"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*128 
	{
		*TEXT "被摧毁，这样我们的人才能通过。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*131 
	{
		*TEXT "而且我相信，唯一真正"
		*SUBTITLEDURATION 3
		*SOUND ls08_04
	}
	*132 
	{
		*TEXT "有足够力量做这件事的人"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*134 
	{
		*TEXT "将会是那位名叫扎尔的传奇法师。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*136 
	{
		*TEXT "他似乎对这种"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*138 
	{
		*TEXT "所需的毁灭性行动很有经验。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*139 
	{
		*TEXT "我听说谣传他至今仍然活着。"
		*SUBTITLEDURATION 3
		*SOUND ls08_05
	}
	*141 
	{
		*TEXT "并且最后一次有人目击到他在一个湖附近，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*143 
	{
		*TEXT "更北边的地方。如果你能完成这件事，"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*145 
	{
		*TEXT "我们将派出你所请求的援助。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*147 
	{
		*TEXT "我们最近刚刚修好了我们的飞艇。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*149 
	{
		*TEXT "带一个装满气体的燃料罐来。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*151 
	{
		*TEXT "你可以用它更快地到达目的地。"
		*SUBTITLEDURATION 3
		*SOUND 
	}
	*153 
	{
		*TEXT "看来你最好快点。"
		*SUBTITLEDURATION 3
		*SOUND ls08_07
	}
	*154 
	{
		*TEXT "荣耀归于帝国！"
		*SUBTITLEDURATION 3
		*SOUND ge_alecto119
	}
	*155 
	{
		*TEXT "那些塞勒海姆的人……"
		*SUBTITLEDURATION 3
		*SOUND ge_alecto120
	}
	*156 
	{
		*TEXT "好吧……好吧！"
		*SUBTITLEDURATION 3
		*SOUND ge_alecto121
	}
	*157 
	{
		*TEXT Guards!
		*SUBTITLEDURATION 3
		*SOUND ge_alecto122
	}
	*158 
	{
		*TEXT "抓住他们！"
		*SUBTITLEDURATION 3
		*SOUND ge_alecto123
	}
	*159 
	{
		*TEXT "是的。"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto001
	}
	*160 
	{
		*TEXT "不。"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto002
	}
	*161 
	{
		*TEXT "嗯。"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto003
	}
	*162 
	{
		*TEXT "我的荣幸。"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto004
	}
	*163 
	{
		*TEXT "很好。"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto005
	}
	*164 
	{
		*TEXT "对。"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto006
	}
	*165 
	{
		*TEXT "别让他们跑了！"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto007
	}
	*166 
	{
		*TEXT "你永远抓不到我！"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto008
	}
	*167 
	{
		*TEXT "受死吧！"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto009
	}
	*168 
	{
		*TEXT "杀了他们！"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto010
	}
	*169 
	{
		*TEXT "你死定了！"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto011
	}
	*170 
	{
		*TEXT "怎么样？"
		*SUBTITLEDURATION 3
		*SOUND gen_alecto012
	}
}
