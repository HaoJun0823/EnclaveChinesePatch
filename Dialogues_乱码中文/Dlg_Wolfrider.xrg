	*100 
	{
		*TEXT "快跑！"
		*SOUND wol_special25a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*101 
	{
		*TEXT "危险的陷阱，你先走！"
		*SOUND wol_special22a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*102 
	{
		*TEXT "小心背后！"
		*SOUND wol_special23a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*103 wol_special19a
	*104 
	{
		*TEXT "不是那个！不是那个！"
		*SUBTITLEDURATION 3
		*SOUND wol_special29a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*105 
	{
		*TEXT "错错错错！"
		*SOUND wol_special31a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*106 
	{
		*TEXT "拉下操纵杆！"
		*SOUND wol_special32a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*107 
	{
		*TEXT "小心斧头！"
		*SOUND wol_special24a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*108 
	{
		*TEXT "跟我来，我知道路！快来！"
		*SOUND wol_special34a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*109 
	{
		*TEXT "来来，跟我来！"
		*SOUND wol_special33a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*110 
	{
		*TEXT "我带路！好地精！是的，是的！"
		*SUBTITLEDURATION 3
		*SOUND wol_special35a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*111 
	{
		*TEXT "好可怕！不想再跟你走了！"
		*SOUND wol_special39a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*112 
	{
		*TEXT "毛茸茸的怪物！毛茸茸的怪物！"
		*SUBTITLEDURATION 2
		*SOUND wol_special36a
		*COLOR 0xfefefe
		*FLAGS 2
	}
	*120 
	{
		*TEXT "过来，听着！"
		*SUBTITLEDURATION 2
		*SOUND wol_special43a
		*FLAGS 2
	}
	*121 
	{
		*TEXT "你真该看看昨天。穆·阿扎姆！"
		*SUBTITLEDURATION 6.5
		*SOUND wol_special44a
		*FLAGS 2
	}
	*122 
	{
		*TEXT "黄金铃铛！好多小杯酒，大头疼！"
		*SUBTITLEDURATION 6.1
		*SOUND wol_special45a
		*FLAGS 2
	}
	*123 
	{
		*TEXT "嗷，你能不能不放我出去？"
		*SUBTITLEDURATION 4.1
		*SOUND wol_special46a
		*FLAGS 2
	}
	*124 
	{
		*TEXT "坏坏的老头，红外套！丑胡子"
		*SUBTITLEDURATION 5.2
		*SOUND wol_special47a
		*FLAGS 2
	}
	*125 
	{
		*TEXT "我被锁住了。给你钱！"
		*SUBTITLEDURATION 3.8
		*SOUND wol_special48a
		*FLAGS 2
	}
	*126 
	{
		*TEXT "看见兄弟飞了！我们是黄金铃铛！"
		*SUBTITLEDURATION 6
		*SOUND wol_special49a
		*FLAGS 2
	}
	*127 
	{
		*TEXT "大兽人，这么大！"
		*SUBTITLEDURATION 4
		*SOUND wol_special50a
		*FLAGS 2
	}
	*128 
	{
		*TEXT "兽人把兄弟扔出去。砰，砰！"
		*SUBTITLEDURATION 5.6
		*SOUND wol_special51a
		*FLAGS 2
	}
	*129 
	{
		*TEXT "可怜的兄弟！嘿你……该死的！"
		*SUBTITLEDURATION 4.8
		*SOUND wol_special52a
		*FLAGS 2
	}
	*130 
	{
		*TEXT "想起来了……兄弟的钥匙，他回不了家了！"
		*SUBTITLEDURATION 6
		*SOUND wol_special53a
		*FLAGS 2
	}
	*131 
	{
		*TEXT "你能不拿钥匙吗？给兄弟。"
		*SUBTITLEDURATION 3.8
		*SOUND wol_special54a
		*FLAGS 2
	}
	*132 
	{
		*TEXT "给。我给你钱……呃……钱！"
		*SUBTITLEDURATION 4.6
		*SOUND wol_special55a
		*FLAGS 2
	}
	*133 
	{
		*TEXT "没钱？没钱？？啊！"
		*SUBTITLEDURATION 6.1
		*SOUND wol_special56a
		*FLAGS 2
	}
	*134 
	{
		*TEXT "我有朋友，堂兄！去梦境庄园。"
		*SUBTITLEDURATION 5.7
		*SOUND wol_special57a
		*FLAGS 2
	}
	*135 
	{
		*TEXT "他很害怕，好害怕！"
		*SUBTITLEDURATION 2.2
		*SOUND wol_special58a
		*FLAGS 2
	}
	*136 
	{
		*TEXT "呃，可是你，可怜的兄弟。放我出去！给钱！钱！"
		*SUBTITLEDURATION 9.5
		*SOUND wol_special59a
		*FLAGS 2
	}
	*137 
	{
		*TEXT "放我出去，告诉你秘密。给你钱。一点点钱。"
		*SUBTITLEDURATION 7.1
		*SOUND wol_special60a
		*FLAGS 2
	}
	*138 
	{
		*TEXT "如果现在不拿钱，你就永远永远没钱了！"
		*SUBTITLEDURATION 5.3
		*SOUND wol_special61a
		*FLAGS 2
	}
	*139 
	{
		*TEXT "可怜的兄弟。拿着他的钥匙。真可怜！"
		*SUBTITLEDURATION 7.3
		*SOUND wol_special62a
		*FLAGS 2
	}
	*140 
	{
		*TEXT "那就忘了我吧。忘了我。走吧！"
		*SUBTITLEDURATION 4.7
		*SOUND wol_special63a
		*FLAGS 2
	}
	*141 
	{
		*TEXT "灯塔下面。全是闪亮的钱！忘了我吧。现在就走！"
		*SUBTITLEDURATION 5.6
		*SOUND wol_special64a
		*FLAGS 2
	}
}
